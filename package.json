{
  "name": "apex-office-suite",
  "private": true,
  "version": "1.0.0",
  "description": "Suite ofimática profesional, libre y segura alternativa a Microsoft Office",
  "author": "Apex Open Source Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "app:dev": "concurrently -k \"vite\" \"wait-on tcp:5175 && electron electron/main.cjs\"",
    "app:start": "electron electron/main.cjs",
    "app:pack": "pnpm build && electron-builder --dir",
    "app:build:win": "pnpm build && electron-builder --win --x64",
    "app:dist": "pnpm build && electron-packager . \"ApexOffice\" --platform=win32 --arch=x64 --out=dist-win --overwrite"
  },
  "build": {
    "appId": "org.apex.office.suite",
    "productName": "Apex Office Suite",
    "copyright": "Copyright © 2026 Apex Suite Open Source",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Apex Office Suite"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wait-on": "^9.5.1"
  }
}
